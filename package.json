{
  "name": "medicore",
  "version": "0.1.0",
  "private": true,
  "description": "MediCore — Indian pharmacy management, billing, distribution and SaaS platform",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint . --max-warnings 0 && pnpm --filter @medicore/web lint",
    "test": "pnpm -r --if-present run test",
    "test:unit": "pnpm -r --if-present run test:unit",
    "test:integration": "pnpm -r --if-present run test:integration",
    "db:start": "./infrastructure/scripts/start-postgres.sh",
    "db:stop": "/Library/PostgreSQL/18/bin/pg_ctl -D \"$HOME/medicore-pgdata\" stop",
    "db:migrate": "pnpm --filter @medicore/api db:migrate",
    "db:seed": "pnpm --filter @medicore/api db:seed",
    "db:studio": "pnpm --filter @medicore/api db:studio"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "globals": "^17.13.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8"
  }
}
