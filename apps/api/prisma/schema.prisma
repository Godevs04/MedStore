// MediCore — Foundation schema (Phase 1): identity, tenancy, RBAC, audit, SaaS.
// Master data (Phase 2) and inventory (Phase 3) are added as separate migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Identity ─────────────────────────────────────────────────────────────────

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  INVITATION
}

model User {
  id                   String     @id @default(uuid())
  email                String     @unique
  emailVerifiedAt      DateTime?  @db.Timestamptz(6)
  passwordHash         String?
  fullName             String
  status               UserStatus @default(INVITED)
  isPlatformSuperadmin Boolean    @default(false)
  failedLoginCount     Int        @default(0)
  lockedUntil          DateTime?  @db.Timestamptz(6)
  lastLoginAt          DateTime?  @db.Timestamptz(6)
  createdAt            DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime   @updatedAt @db.Timestamptz(6)

  sessions        Session[]
  authTokens      AuthToken[]
  memberships     OrganizationMembership[]
  loginAttempts   LoginAttempt[]
  passwordHistory PasswordHistoryEntry[]

  @@index([status])
}

model PasswordHistoryEntry {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId, createdAt])
}

/// Opaque session tokens; only the SHA-256 hash is stored.
model Session {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  /// Device/user-agent hint for session visibility. Never contains credentials.
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  lastSeenAt   DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt    DateTime  @db.Timestamptz(6)
  revokedAt    DateTime? @db.Timestamptz(6)

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  success   Boolean
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([email, createdAt])
  @@index([userId, createdAt])
}

/// Single-use auth tokens (email verification, password reset, invitations).
model AuthToken {
  id          String        @id @default(uuid())
  userId      String?
  user        User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        AuthTokenType
  tokenHash   String        @unique
  /// For invitations: which membership this token activates.
  membershipId String?
  membership  OrganizationMembership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  expiresAt   DateTime      @db.Timestamptz(6)
  usedAt      DateTime?     @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)

  @@index([userId, type])
}

// ── Tenancy ──────────────────────────────────────────────────────────────────

model Organization {
  id                   String   @id @default(uuid())
  name                 String
  slug                 String   @unique
  legalEntityName      String?
  gstRegistrationStatus String  @default("UNREGISTERED") // REGULAR | COMPOSITION | UNREGISTERED | CONSUMER
  gstin                String?
  pan                  String?
  addressLine1         String?
  addressLine2         String?
  city                 String?
  stateCode            String?
  pinCode              String?
  contactPhone         String?
  contactEmail         String?
  currency             String   @default("INR")
  timezone             String   @default("Asia/Kolkata")
  financialYearStartMonth Int    @default(4)
  /// Setup completeness gate: organization cannot post real transactions
  /// until required setup steps are done (spec §6).
  setupCompletedAt     DateTime? @db.Timestamptz(6)
  createdAt            DateTime @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @db.Timestamptz(6)

  memberships     OrganizationMembership[]
  branches        Branch[]
  roles           Role[]
  subscription    Subscription?
  settings        OrganizationSettings?
  featureEntitlements FeatureEntitlement[]
  usageRecords    UsageRecord[]
  auditLogs       AuditLog[]
  numberSequences DocumentNumberSequence[]
  pharmacyLicences PharmacyLicence[]

  @@index([name])
}

model OrganizationMembership {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId         String?
  role           Role?            @relation(fields: [roleId], references: [id])
  status         MembershipStatus @default(INVITED)
  isOwner        Boolean          @default(false)
  invitedAt      DateTime         @default(now()) @db.Timestamptz(6)
  joinedAt       DateTime?        @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(6)

  branchAssignments UserBranchAssignment[]
  authTokens        AuthToken[]

  @@unique([organizationId, userId])
  @@index([userId])
}

model Branch {
  id               String   @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  code             String?
  addressLine1     String?
  city             String?
  stateCode        String?
  pinCode          String?
  phone            String?
  gstin            String?
  isBillingEnabled Boolean  @default(true)
  isDefault        Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  warehouses    Warehouse[]
  billingCounters BillingCounter[]
  assignments   UserBranchAssignment[]
  licences      PharmacyLicence[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Warehouse {
  id             String  @id @default(uuid())
  organizationId String
  branchId       String
  branch         Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name           String
  code           String?
  isDefault      Boolean @default(false)
  isActive       Boolean @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  @@unique([branchId, code])
  @@index([organizationId])
}

model BillingCounter {
  id        String  @id @default(uuid())
  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([branchId, name])
}

model UserBranchAssignment {
  id           String                 @id @default(uuid())
  membershipId String
  membership   OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([membershipId, branchId])
}

// ── RBAC ─────────────────────────────────────────────────────────────────────

model Role {
  id             String   @id @default(uuid())
  organizationId String?
  /// Null organizationId = platform-level system role template.
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String?
  /// Human-readable name; must be unique per organization.
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  permissions RolePermission[]
  memberships OrganizationMembership[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Permission {
  id    String @id @default(uuid())
  /// Dotted key, e.g. "sales.create" (spec §4).
  key   String @unique
  description String?

  roles RolePermission[]
}

// ── SaaS plans & subscriptions ───────────────────────────────────────────────

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE
  CANCELLED
  EXPIRED
}

model SubscriptionPlan {
  id            String   @id @default(uuid())
  key           String   @unique // TRIAL | STARTER | PROFESSIONAL | BUSINESS | ENTERPRISE
  name          String
  description   String?
  /// Plan limits: maxBranches, maxUsers, maxWarehouses, monthlyInvoiceLimit,
  /// storageMb, apiAccess, modules[] — all configurable by platform admins.
  limits        Json
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  subscriptions Subscription[]
}

model Subscription {
  id             String            @id @default(uuid())
  organizationId String            @unique
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId         String
  plan           SubscriptionPlan  @relation(fields: [planId], references: [id])
  status         SubscriptionStatus @default(TRIALING)
  trialEndsAt    DateTime?         @db.Timestamptz(6)
  currentPeriodStart DateTime      @default(now()) @db.Timestamptz(6)
  currentPeriodEnd   DateTime      @db.Timestamptz(6)
  graceEndsAt    DateTime?         @db.Timestamptz(6)
  cancelledAt    DateTime?         @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(6)

  /// Subscription lifecycle changes are recorded here (spec §5).
  events         SubscriptionEvent[]
}

model SubscriptionEvent {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  eventType      String
  fromPlanId     String?
  toPlanId       String?
  actorUserId    String?
  notes          String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)

  @@index([subscriptionId, createdAt])
}

model FeatureEntitlement {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  featureKey     String
  enabled        Boolean      @default(false)
  /// Optional per-org limit overrides (JSON), e.g. { "monthlyInvoiceLimit": 500 }.
  limits         Json?
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)

  @@unique([organizationId, featureKey])
}

model UsageRecord {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  metric         String
  periodStart    DateTime @db.Timestamptz(6)
  periodEnd      DateTime @db.Timestamptz(6)
  value          Int      @default(0)

  @@unique([organizationId, metric, periodStart])
}

// ── Organization settings & numbering ────────────────────────────────────────

model OrganizationSettings {
  id             String   @id @default(uuid())
  organizationId String   @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Free-form but schema-validated JSON: receipt printer, expiry thresholds,
  /// discount approval limits, POS defaults, feature toggles. Not for secrets.
  settings       Json     @default("{}")
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)
}

/// Server-controlled document numbering (spec §12). Rows are locked with
/// SELECT ... FOR UPDATE inside the posting transaction.
model DocumentNumberSequence {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scope          String
  /// Indian FY label, e.g. "2026-27"; null = continuous series.
  fiscalYear     String?
  prefix         String   @default("")
  nextNumber     Int      @default(1)

  @@unique([organizationId, scope, fiscalYear, prefix])
}

// ── Compliance (licence registry — Phase 1 tracking, workflows later) ────────

model PharmacyLicence {
  id               String   @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId         String?
  branch           Branch?  @relation(fields: [branchId], references: [id])
  licenceType      String
  licenceNumber    String
  issuingAuthority String?
  issueDate        DateTime? @db.Timestamptz(6)
  expiryDate       DateTime @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  @@index([organizationId, expiryDate])
}

// ── Audit ────────────────────────────────────────────────────────────────────

/// Append-only audit trail. Services must never update or delete rows;
/// the application DB role has UPDATE/DELETE revoked (security model doc).
model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  actorUserId    String?
  actorEmail     String?
  event          String
  entityType     String?
  entityId       String?
  /// Redacted diff/details JSON — never contains secrets or PHI (spec §1.28).
  details        Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
}

// ── Master data (Phase 2) ────────────────────────────────────────────────────

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum PrescriptionClass {
  OTC
  PRESCRIPTION_ONLY
  SCHEDULE_H1
  SCHEDULE_X
  NARCOTIC
}

enum VendorStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model ProductCategory {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  parentId       String?
  parent         ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children       ProductCategory[] @relation("CategoryTree")
  description    String?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  products Product[]

  @@unique([organizationId, name])
}

model Manufacturer {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  contactEmail   String?
  contactPhone   String?
  notes          String?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  products Product[]

  @@unique([organizationId, name])
}

/// Versioned, effective-dated tax configuration (spec §13: never hardcode rates).
/// A product references the version active at sale time; posted documents
/// snapshot the rates actually applied.
model TaxRateVersion {
  id             String   @id @default(uuid())
  organizationId String
  hsnCode        String
  description    String
  cgstPercent    Decimal? @db.Decimal(5, 2)
  sgstPercent    Decimal? @db.Decimal(5, 2)
  igstPercent    Decimal? @db.Decimal(5, 2)
  cessPercent    Decimal? @db.Decimal(5, 2)
  effectiveFrom  DateTime @db.Timestamptz(6)
  effectiveTo    DateTime? @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  products Product[]

  @@index([organizationId, hsnCode, effectiveFrom])
}

model Product {
  id                   String   @id @default(uuid())
  organizationId       String
  sku                  String
  name                 String
  genericName          String?
  brand                String?
  categoryId           String?
  category             ProductCategory? @relation(fields: [categoryId], references: [id])
  manufacturerId       String?
  manufacturer         Manufacturer?    @relation(fields: [manufacturerId], references: [id])
  dosageForm           String?
  strength             String?
  packSize             String?
  unitsPerPack         Int?
  purchaseUnit         String?
  saleUnit             String?
  unitConversionFactor Decimal? @db.Decimal(12, 4)
  hsnCode              String?
  taxRateVersionId     String?
  taxRateVersion       TaxRateVersion?  @relation(fields: [taxRateVersionId], references: [id])
  mrp                  Decimal? @db.Decimal(18, 4)
  purchasePrice        Decimal? @db.Decimal(18, 4)
  sellingPrice         Decimal? @db.Decimal(18, 4)
  tradePrice           Decimal? @db.Decimal(18, 4)
  prescriptionClass    PrescriptionClass?
  storageInstructions  String?
  requiresRefrigeration Boolean @default(false)
  rackLocation         String?
  reorderLevel         Int?
  maxStockLevel        Int?
  minOrderQuantity     Int?
  status               ProductStatus @default(ACTIVE)
  createdByUserId      String?
  createdAt            DateTime @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @db.Timestamptz(6)

  barcodes      ProductBarcode[]
  batches       InventoryBatch[]
  supplierLinks ProductSupplierMapping[]
  changeHistory ProductChangeHistory[]
  poLines       PurchaseOrderLine[]
  grnLines      GoodsReceiptLine[]
  purchaseInvoiceLines PurchaseInvoiceLine[]
  salesInvoiceLines SalesInvoiceLine[]

  @@unique([organizationId, sku])
  @@index([organizationId, name])
  @@index([organizationId, genericName])
  @@index([organizationId, status])
}

model ProductBarcode {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  barcode   String

  @@unique([productId, barcode])
  @@index([barcode])
}

/// Supplier-specific product codes and price references.
model ProductSupplierMapping {
  id             String  @id @default(uuid())
  productId      String
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendorId       String
  vendor         Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  supplierSku    String?
  lastPurchaseRate Decimal? @db.Decimal(18, 4)

  @@unique([vendorId, productId])
}

/// Append-only change log for product master edits (spec §7).
model ProductChangeHistory {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  actorUserId String?
  changeType String
  details    Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  @@index([productId, createdAt])
}

model Vendor {
  id                  String   @id @default(uuid())
  organizationId      String
  legalName           String
  tradeName           String?
  gstin               String?
  pan                 String?
  gstRegistrationType String   @default("REGULAR")
  addressLine1        String?
  addressLine2        String?
  city                String?
  stateCode           String?
  pinCode             String?
  contactName         String?
  phone               String?
  email               String?
  creditDays          Int      @default(30)
  /// Decimal-string money; positive opening balance = we owe the supplier.
  creditLimit         Decimal  @default(0) @db.Decimal(18, 2)
  openingBalance      Decimal  @default(0) @db.Decimal(18, 2)
  status              VendorStatus @default(ACTIVE)
  /// Supplier's wholesale drug licence (Form 20B/21B) — verified before purchase.
  drugLicenceNumber   String?
  drugLicenceExpiry   DateTime? @db.Date
  bankAccount         String?
  ifsc                String?
  notes               String?
  createdByUserId     String?
  createdAt           DateTime @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @db.Timestamptz(6)

  productLinks ProductSupplierMapping[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  purchaseInvoices PurchaseInvoice[]
  supplierPayments SupplierPayment[]
  purchaseReturns  PurchaseReturn[]

  @@index([organizationId, legalName])
  @@index([organizationId, status])
}

model Customer {
  id              String   @id @default(uuid())
  organizationId  String
  name            String
  category        String?
  gstin           String?
  phone           String?
  email           String?
  addressLine1    String?
  city            String?
  stateCode       String?
  pinCode         String?
  creditDays      Int      @default(0)
  creditLimit     Decimal  @default(0) @db.Decimal(18, 2)
  /// Positive opening balance = customer owes us.
  openingBalance  Decimal  @default(0) @db.Decimal(18, 2)
  status          CustomerStatus @default(ACTIVE)
  isWholesale     Boolean  @default(false)
  notes           String?
  createdByUserId String?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  salesInvoices SalesInvoice[]

  @@index([organizationId, name])
  @@index([organizationId, status])
  @@index([organizationId, phone])
}

// ── Inventory engine (Phase 3) ───────────────────────────────────────────────

enum BatchStatus {
  SALEABLE
  QUARANTINED
  RECALLED
  DAMAGED
  EXPIRED_BLOCKED
}

enum MovementType {
  OPENING_STOCK
  PURCHASE_RECEIPT
  SALE
  SALES_RETURN_IN
  PURCHASE_RETURN_OUT
  EXPIRY_RETURN_OUT
  DAMAGE_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_OUT
  TRANSFER_IN
  COUNT_VARIANCE_IN
  COUNT_VARIANCE_OUT
  RECALL_OUT
  QUARANTINE_IN
  QUARANTINE_RELEASE
  SALE_CANCELLED_IN
}

enum TransferStatus {
  DRAFT
  DISPATCHED
  IN_TRANSIT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum CountStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  POSTED
  CANCELLED
}

/// A batch is one manufacturer lot of one product with its own expiry,
/// cost, and MRP. Same (product, batchNumber, expiry) received twice merges
/// into the existing batch (service-level rule).
model InventoryBatch {
  id             String   @id @default(uuid())
  organizationId String
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  warehouseId    String
  batchNumber    String
  expiryDate     DateTime @db.Timestamptz(6)
  manufacturingDate DateTime? @db.Timestamptz(6)
  supplierId     String?
  purchaseRate   Decimal  @db.Decimal(18, 4)
  mrp            Decimal  @db.Decimal(18, 4)
  landedCost     Decimal? @db.Decimal(18, 4)
  status         BatchStatus @default(SALEABLE)
  sourceDocument String?
  createdByUserId String?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  movements  InventoryMovement[]
  balances   InventoryBalance[]
  transfersOut StockTransferLine[] @relation("BatchTransferOut")
  countLines StockCountLine[]
  adjustments StockAdjustment[]
  recalls   RecallRecord[]
  salesAllocations SalesBatchAllocation[]
  purchaseReturnLines PurchaseReturnLine[]
  salesReturnLines SalesReturnLine[]

  @@unique([organizationId, productId, warehouseId, batchNumber, expiryDate])
  @@index([organizationId, productId, expiryDate])
  @@index([organizationId, expiryDate])
}

/// Transactionally-maintained per (batch, warehouse) balance. The append-only
/// movement ledger is the source of truth; a reconciliation test asserts
/// balances == sum(movements) (spec §8, §26.D).
model InventoryBalance {
  id           String   @id @default(uuid())
  organizationId String
  batchId      String
  batch        InventoryBatch @relation(fields: [batchId], references: [id])
  warehouseId  String
  quantity     Decimal  @default(0) @db.Decimal(14, 3)
  reservedQty  Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  @@unique([batchId, warehouseId])
  @@index([organizationId, warehouseId])
}

/// Append-only stock movement ledger (spec §8): actor, source document,
/// batch, signed quantity, reason. Never updated or deleted (compensating
/// movements only).
model InventoryMovement {
  id             String   @id @default(uuid())
  organizationId String
  batchId        String
  batch          InventoryBatch @relation(fields: [batchId], references: [id])
  warehouseId    String
  movementType   MovementType
  /// Signed quantity: positive IN, negative OUT.
  quantity       Decimal  @db.Decimal(14, 3)
  reason         String?
  sourceDocument String?
  sourceDocumentId String?
  actorUserId    String
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  @@index([batchId, createdAt])
  @@index([organizationId, warehouseId, createdAt])
}

/// Soft reservations against a batch (e.g., pending transfer dispatch).
model StockReservation {
  id             String   @id @default(uuid())
  organizationId String
  batchId        String
  warehouseId    String
  quantity       Decimal  @db.Decimal(14, 3)
  referenceType  String
  referenceId    String
  createdById    String
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  releasedAt     DateTime? @db.Timestamptz(6)

  @@index([batchId, releasedAt])
}

model StockAdjustment {
  id             String   @id @default(uuid())
  organizationId String
  batchId        String
  warehouseId    String
  direction      String
  quantity       Decimal  @db.Decimal(14, 3)
  reason         String
  notes          String?
  movementId     String
  actorUserId    String
  batch          InventoryBatch @relation(fields: [batchId], references: [id])
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  @@index([organizationId, createdAt])
}

model StockCount {
  id             String   @id @default(uuid())
  organizationId String
  warehouseId    String
  status         CountStatus @default(DRAFT)
  notes          String?
  createdByUserId String
  postedAt       DateTime? @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  lines StockCountLine[]

  @@index([organizationId, status])
}

model StockCountLine {
  id         String  @id @default(uuid())
  countId    String
  count      StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  batchId    String
  batch      InventoryBatch @relation(fields: [batchId], references: [id])
  countedQty Decimal @db.Decimal(14, 3)
  systemQty  Decimal @db.Decimal(14, 3)
  variance   Decimal @db.Decimal(14, 3)

  @@unique([countId, batchId])
}

model StockTransfer {
  id                   String   @id @default(uuid())
  organizationId       String
  sourceWarehouseId    String
  destinationWarehouseId String
  status               TransferStatus @default(DRAFT)
  notes                String?
  dispatchedAt         DateTime? @db.Timestamptz(6)
  receivedAt           DateTime? @db.Timestamptz(6)
  createdById          String
  createdAt            DateTime @default(now()) @db.Timestamptz(6)

  lines StockTransferLine[]

  @@index([organizationId, status])
}

model StockTransferLine {
  id           String  @id @default(uuid())
  transferId   String
  transfer     StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId    String
  batchId      String
  batch        InventoryBatch @relation("BatchTransferOut", fields: [batchId], references: [id])
  quantity     Decimal @db.Decimal(14, 3)
  receivedQty  Decimal @default(0) @db.Decimal(14, 3)

  @@unique([transferId, batchId])
}

model RecallRecord {
  id             String   @id @default(uuid())
  organizationId String
  batchId        String
  batch          InventoryBatch @relation(fields: [batchId], references: [id])
  reason         String
  notes          String?
  status         String   @default("OPEN")
  resolutionNotes String?
  createdById    String
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  resolvedAt     DateTime? @db.Timestamptz(6)

  @@index([organizationId, status])
}

// ── Purchasing (Phase 4) ─────────────────────────────────────────────────────

enum POStatus {
  DRAFT
  SENT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PurchaseInvoiceStatus {
  PENDING
  POSTED
  PAID
  PARTIALLY_PAID
  CANCELLED
}

enum PurchaseReturnStatus {
  DRAFT
  DISPATCHED
  ACKNOWLEDGED
  CANCELLED
}

model PurchaseOrder {
  id             String   @id @default(uuid())
  organizationId String
  poNumber       String
  vendorId       String
  vendor         Vendor   @relation(fields: [vendorId], references: [id])
  status         POStatus @default(DRAFT)
  orderDate      DateTime @db.Timestamptz(6)
  expectedDate   DateTime? @db.Timestamptz(6)
  notes          String?
  createdById    String
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  lines        PurchaseOrderLine[]
  receipts     GoodsReceipt[]

  @@unique([organizationId, poNumber])
  @@index([organizationId, status])
}

model PurchaseOrderLine {
  id          String  @id @default(uuid())
  poId        String
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  quantity    Decimal @db.Decimal(14, 3)
  receivedQty Decimal @default(0) @db.Decimal(14, 3)
  unitPrice   Decimal @db.Decimal(18, 4)

  @@unique([poId, productId])
}

model GoodsReceipt {
  id             String   @id @default(uuid())
  organizationId String
  grnNumber      String
  poId           String?
  po             PurchaseOrder? @relation(fields: [poId], references: [id])
  vendorId       String
  vendor         Vendor   @relation(fields: [vendorId], references: [id])
  warehouseId    String
  receivedDate   DateTime @db.Timestamptz(6)
  notes          String?
  createdById    String
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  lines  GoodsReceiptLine[]
  invoices PurchaseInvoice[]

  @@unique([organizationId, grnNumber])
  @@index([organizationId, vendorId])
}

model GoodsReceiptLine {
  id           String  @id @default(uuid())
  grnId        String
  grn          GoodsReceipt @relation(fields: [grnId], references: [id], onDelete: Cascade)
  poLineId     String?
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  batchNumber  String
  expiryDate   DateTime @db.Timestamptz(6)
  quantity     Decimal @db.Decimal(14, 3)
  freeQuantity Decimal @default(0) @db.Decimal(14, 3)
  purchaseRate Decimal @db.Decimal(18, 4)
  mrp          Decimal @db.Decimal(18, 4)
}

model PurchaseInvoice {
  id             String   @id @default(uuid())
  organizationId String
  invoiceNumber  String
  vendorId       String
  vendor         Vendor   @relation(fields: [vendorId], references: [id])
  grnId          String?
  grn            GoodsReceipt? @relation(fields: [grnId], references: [id])
  invoiceDate    DateTime @db.Timestamptz(6)
  dueDate        DateTime @db.Timestamptz(6)
  subtotal       Decimal  @db.Decimal(18, 2)
  taxAmount      Decimal  @db.Decimal(18, 2)
  total          Decimal  @db.Decimal(18, 2)
  paidAmount     Decimal  @default(0) @db.Decimal(18, 2)
  status         PurchaseInvoiceStatus @default(PENDING)
  journalEntryId String?
  createdById    String
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  lines      PurchaseInvoiceLine[]
  allocations SupplierPaymentAllocation[]

  /// Duplicate prevention: same vendor cannot post the same invoice number twice (spec §9).
  @@unique([organizationId, vendorId, invoiceNumber])
  @@index([organizationId, status])
}

model PurchaseInvoiceLine {
  id         String  @id @default(uuid())
  invoiceId  String
  invoice    PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  quantity   Decimal @db.Decimal(14, 3)
  freeQty    Decimal @default(0) @db.Decimal(14, 3)
  unitCost   Decimal @db.Decimal(18, 4)
  taxableValue Decimal @db.Decimal(18, 2)
  cgstAmount Decimal @default(0) @db.Decimal(18, 2)
  sgstAmount Decimal @default(0) @db.Decimal(18, 2)
  igstAmount Decimal @default(0) @db.Decimal(18, 2)
  cessAmount Decimal @default(0) @db.Decimal(18, 2)
  lineTotal  Decimal @db.Decimal(18, 2)
}

model SupplierPayment {
  id            String   @id @default(uuid())
  organizationId String
  paymentNumber String
  vendorId      String
  vendor        Vendor   @relation(fields: [vendorId], references: [id])
  paymentDate   DateTime @db.Timestamptz(6)
  amount        Decimal  @db.Decimal(18, 2)
  method        String
  reference     String?
  journalEntryId String?
  createdById   String
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  allocations SupplierPaymentAllocation[]

  @@unique([organizationId, paymentNumber])
}

model SupplierPaymentAllocation {
  id        String  @id @default(uuid())
  paymentId String
  payment   SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   PurchaseInvoice @relation(fields: [invoiceId], references: [id])
  amount    Decimal @db.Decimal(18, 2)

  @@unique([paymentId, invoiceId])
}

model PurchaseReturn {
  id             String   @id @default(uuid())
  organizationId String
  returnNumber   String
  vendorId       String
  vendor         Vendor   @relation(fields: [vendorId], references: [id])
  invoiceId      String?
  reason         String
  status         PurchaseReturnStatus @default(DRAFT)
  total          Decimal  @default(0) @db.Decimal(18, 2)
  taxAmount      Decimal  @default(0) @db.Decimal(18, 2)
  journalEntryId String?
  createdById    String
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  lines PurchaseReturnLine[]

  @@unique([organizationId, returnNumber])
}

model PurchaseReturnLine {
  id        String  @id @default(uuid())
  returnId  String
  return    PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  batchId   String
  batch     InventoryBatch @relation(fields: [batchId], references: [id])
  quantity  Decimal @db.Decimal(14, 3)
  rate      Decimal @db.Decimal(18, 4)
  taxAmount Decimal @default(0) @db.Decimal(18, 2)
  lineTotal Decimal @db.Decimal(18, 2)
}

// ── Sales & POS (Phase 5) + Returns (Phase 6) ────────────────────────────────

enum SalesInvoiceStatus {
  POSTED
  PARTIALLY_RETURNED
  RETURNED
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  CREDIT
  BANK
}

model SalesInvoice {
  id             String   @id @default(uuid())
  organizationId String
  invoiceNumber  String
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])
  walkInName     String?
  status         SalesInvoiceStatus @default(POSTED)
  invoiceDate    DateTime @db.Timestamptz(6)
  subtotal       Decimal  @db.Decimal(18, 2)
  discountAmount Decimal  @default(0) @db.Decimal(18, 2)
  taxableValue   Decimal  @db.Decimal(18, 2)
  cgstAmount     Decimal  @default(0) @db.Decimal(18, 2)
  sgstAmount     Decimal  @default(0) @db.Decimal(18, 2)
  igstAmount     Decimal  @default(0) @db.Decimal(18, 2)
  cessAmount     Decimal  @default(0) @db.Decimal(18, 2)
  roundOff       Decimal  @default(0) @db.Decimal(18, 2)
  total          Decimal  @db.Decimal(18, 2)
  paidAmount     Decimal  @default(0) @db.Decimal(18, 2)
  creditAmount   Decimal  @default(0) @db.Decimal(18, 2)
  returnedAmount Decimal  @default(0) @db.Decimal(18, 2)
  isWholesale    Boolean  @default(false)
  /// Idempotency for POS retries (spec §11): same key never double-posts.
  idempotencyKey String?
  warehouseId    String
  journalEntryId String?
  createdById    String
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  cancelledAt    DateTime? @db.Timestamptz(6)
  cancelledById  String?
  cancelReason   String?

  lines     SalesInvoiceLine[]
  payments  SalesPayment[]
  returns   SalesReturn[]
  prescriptions PrescriptionRecord[]

  @@unique([organizationId, invoiceNumber])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, invoiceDate])
  @@index([organizationId, customerId])
}

model SalesInvoiceLine {
  id           String  @id @default(uuid())
  invoiceId    String
  invoice      SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  productName  String
  quantity     Decimal @db.Decimal(14, 3)
  unitPrice    Decimal @db.Decimal(18, 4)
  discountAmount Decimal @default(0) @db.Decimal(18, 2)
  taxableValue Decimal @db.Decimal(18, 2)
  cgstAmount   Decimal @default(0) @db.Decimal(18, 2)
  sgstAmount   Decimal @default(0) @db.Decimal(18, 2)
  igstAmount   Decimal @default(0) @db.Decimal(18, 2)
  cessAmount   Decimal @default(0) @db.Decimal(18, 2)
  taxRatePercent Decimal @default(0) @db.Decimal(5, 2)
  hsnCode      String?
  lineTotal    Decimal @db.Decimal(18, 2)
  costOfGoods  Decimal @default(0) @db.Decimal(18, 2)
  returnedQty  Decimal @default(0) @db.Decimal(14, 3)

  batchAllocations SalesBatchAllocation[]
  returnLines SalesReturnLine[]
}

model SalesBatchAllocation {
  id       String @id @default(uuid())
  lineId   String
  line     SalesInvoiceLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  batchId  String
  batch    InventoryBatch @relation(fields: [batchId], references: [id])
  quantity Decimal @db.Decimal(14, 3)

  @@index([batchId])
}

model SalesPayment {
  id         String  @id @default(uuid())
  invoiceId  String
  invoice    SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  method     PaymentMethod
  amount     Decimal @db.Decimal(18, 2)
  reference  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
}

model SalesReturn {
  id             String   @id @default(uuid())
  organizationId String
  returnNumber   String
  invoiceId      String
  invoice        SalesInvoice @relation(fields: [invoiceId], references: [id])
  customerId     String?
  reason         String
  refundTotal    Decimal  @db.Decimal(18, 2)
  taxAmount      Decimal  @default(0) @db.Decimal(18, 2)
  /// Portion settled against the customer's credit balance; remainder refunded via refundMethod.
  creditAdjusted Decimal  @default(0) @db.Decimal(18, 2)
  refundMethod   PaymentMethod?
  journalEntryId String?
  createdById    String
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  lines SalesReturnLine[]

  @@unique([organizationId, returnNumber])
}

model SalesReturnLine {
  id           String  @id @default(uuid())
  returnId     String
  return       SalesReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  invoiceLineId String
  invoiceLine  SalesInvoiceLine @relation(fields: [invoiceLineId], references: [id])
  batchId      String
  batch        InventoryBatch @relation(fields: [batchId], references: [id])
  quantity     Decimal @db.Decimal(14, 3)
  unitPrice    Decimal @db.Decimal(18, 4)
  taxableValue Decimal @db.Decimal(18, 2)
  taxAmount    Decimal @default(0) @db.Decimal(18, 2)
  lineTotal    Decimal @db.Decimal(18, 2)
  /// Return accepted back into saleable stock (condition-checked, spec §15).
  restock      Boolean @default(false)
}

// ── Accounting (Phase 7) ─────────────────────────────────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

model Account {
  id             String   @id @default(uuid())
  organizationId String
  code           String
  name           String
  type           AccountType
  isSystem       Boolean  @default(false)
  /// System accounts referenced by auto-posting mapping (CASH, AR, INVENTORY...).
  systemKey      String?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  journalLines JournalLine[]

  @@unique([organizationId, code])
  @@unique([organizationId, systemKey])
}

model JournalEntry {
  id             String   @id @default(uuid())
  organizationId String
  entryNumber    String
  entryDate      DateTime @db.Timestamptz(6)
  memo           String
  sourceType     String?
  sourceId       String?
  /// Posted entries are immutable; corrections are reversing entries (spec §17).
  reversedById   String?
  createdById    String
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  lines JournalLine[]

  @@unique([organizationId, entryNumber])
  @@index([organizationId, entryDate])
  @@index([sourceType, sourceId])
}

model JournalLine {
  id        String  @id @default(uuid())
  entryId   String
  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId String
  account   Account @relation(fields: [accountId], references: [id])
  debit     Decimal @db.Decimal(18, 2)
  credit    Decimal @db.Decimal(18, 2)

  @@index([accountId])
}

model Expense {
  id             String   @id @default(uuid())
  organizationId String
  expenseNumber  String
  category       String
  payee          String
  amount         Decimal  @db.Decimal(18, 2)
  method         PaymentMethod
  expenseDate    DateTime @db.Timestamptz(6)
  notes          String?
  journalEntryId String?
  createdById    String
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  @@unique([organizationId, expenseNumber])
}

model AccountingPeriod {
  id             String   @id @default(uuid())
  organizationId String
  periodLabel    String
  /// Periods control backdated posting (spec §17 period locking).
  status         String   @default("OPEN")
  lockedAt       DateTime? @db.Timestamptz(6)
  lockedById     String?

  @@unique([organizationId, periodLabel])
}

// ── Compliance (Phase 8) ─────────────────────────────────────────────────────

/// Schedule H1 register entries (rule 65(3)(h)): prescriber name+address,
/// patient, drug, quantity; 3-year retention (see docs/compliance).
model PrescriptionRecord {
  id             String   @id @default(uuid())
  organizationId String
  invoiceId      String
  invoice        SalesInvoice @relation(fields: [invoiceId], references: [id])
  patientName    String
  prescriberName String
  prescriberAddress String
  /// State medical council registration number of the prescriber.
  prescriberRegNo String?
  patientPhone   String?
  drugName       String
  quantity       Decimal  @db.Decimal(14, 3)
  dispensedAt    DateTime @db.Timestamptz(6)

  @@index([organizationId, dispensedAt])
}

enum IntegrationStatus {
  NOT_CONNECTED
  CONNECTED
  ERROR
}

/// Integration registry (spec §30): nothing is CONNECTED until actually
/// tested — the status is honest by construction.
model IntegrationConnection {
  id             String   @id @default(uuid())
  organizationId String
  provider       String
  status         IntegrationStatus @default(NOT_CONNECTED)
  /// Non-secret config snapshot; credentials live in env/secrets manager.
  config         Json?
  lastTestedAt   DateTime? @db.Timestamptz(6)
  lastError      String?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  @@unique([organizationId, provider])
}

// ── Notifications (Phase 10) ─────────────────────────────────────────────────

model AppNotification {
  id             String   @id @default(uuid())
  organizationId String
  type           String
  title          String
  body           String
  entityType     String?
  entityId       String?
  readAt         DateTime? @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  @@index([organizationId, createdAt])
  @@index([organizationId, readAt])
}

/// POS bill parked by a cashier to serve another customer; restored later.
model HeldBill {
  id             String   @id @default(uuid())
  organizationId String
  branchId       String?
  label          String
  customerId     String?
  /// Cart snapshot (lines, customer, payments) as captured by the POS.
  payload        Json
  itemCount      Int
  total          Decimal  @db.Decimal(18, 2)
  createdById    String
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  @@index([organizationId, createdAt])
}
