# MediCore API environment — copy to .env and adjust
NODE_ENV=development
PORT=3001
# Local dedicated cluster (infrastructure/scripts/start-postgres.sh)
DATABASE_URL=postgresql://medicore@localhost:5433/medicore_dev
# 32+ bytes; generate with: openssl rand -base64 32
SESSION_SECRET=dev-only-session-secret-change-me-32bytes!!
CORS_ORIGIN=http://localhost:3000
# Comma-separated emails to bootstrap as platform superadmins during seed
SUPERADMIN_EMAILS=
# console | smtp (smtp not implemented yet — console only for now)
EMAIL_TRANSPORT=console
