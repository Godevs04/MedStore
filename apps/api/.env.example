# MediCore API environment — copy to .env and adjust
NODE_ENV=development
PORT=3001
# Local dedicated cluster (infrastructure/scripts/start-postgres.sh)
DATABASE_URL=postgresql://medicore@localhost:5433/medicore_dev
# 32+ bytes; generate with: openssl rand -base64 32
SESSION_SECRET=dev-only-session-secret-change-me-32bytes!!
CORS_ORIGIN=http://localhost:3000
# Public web origin used in emailed links (reset, invitation, verification); defaults to the first CORS_ORIGIN
# WEB_APP_URL=https://app.example.in
# Comma-separated emails to bootstrap as platform superadmins during seed
SUPERADMIN_EMAILS=
# console | smtp
EMAIL_TRANSPORT=console
# SMTP (when EMAIL_TRANSPORT=smtp). Port 587 uses STARTTLS, 465 implicit TLS. Gmail needs an app password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_NAME=MediCore
# Razorpay (plan payments). Use rzp_test_ keys until you go live. Online payment returns 503 when unset.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# Webhook secret you set in Razorpay Dashboard > Webhooks (URL: <API origin>/api/v1/billing/webhook)
# RAZORPAY_WEBHOOK_SECRET=
